{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.1/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "FairFuse",
    "version": "pilot",
    "authors": ["FairFuse"],
    "date": "2026-02-23",
    "description": "FairFuse",
    "organizations": ["WPI"]
  },
  "uiConfig": {
    "contactEmail": "contact@revisit.dev",
    "helpTextPath": "fairfuse/assets/introduction.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": true
  },
  "baseComponents": {
    "fairfuseApp": {
      "description": "Test description",
      "withSidebar": false,
      "type": "react-component",
      "path": "fairfuse/assets/FairFuseApp.tsx",
      "nextButtonLocation": "sidebar",
      "showTitleBar": false,
      "response": []
    }
  },
  "components": {
    "introduction": {
      "type": "markdown",
      "path": "fairfuse/assets/introduction.md",
      "response": []
    },
    "taskRace": {
      "baseComponent": "fairfuseApp",
      "response": [
        {
          "id": "race",
          "type": "radio",
          "prompt": "What is the <strong>race</strong> of <strong>Taylor Landry</strong>?",
          "options": ["Native", "Black", "White", "Pacific Islander", "Asian"],
          "location": "sidebar"
        }
      ]
    },
    "taskGroupAdv": {
      "baseComponent": "fairfuseApp",
      "response": [
        {
          "id": "groupAdv",
          "type": "checkbox",
          "prompt": "Which race groups are <strong>over advantaged</strong> in the <strong>Math</strong> ranking? (Please select all that apply)",
          "options": ["Native", "Black", "White", "Pacific Islander", "Asian"],
          "location": "sidebar"
        }
      ]
    }
  },
  "sequence": {
    "order": "fixed",
    "components": ["introduction", "taskRace", "taskGroupAdv"]
  }
}
