{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.1/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "FairFuse",
    "version": "pilot",
    "authors": ["FairFuse"],
    "date": "2026-02-23",
    "description": "FairFuse",
    "organizations": ["WPI"]
  },
  "uiConfig": {
    "contactEmail": "contact@revisit.dev",
    "helpTextPath": "fairfuse/assets/introduction.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": true,
    "recordAudio": true,
    "recordScreen": true,
    "recordScreenFPS": 30
  },
  "importedLibraries": ["screen-recording"],
  "baseComponents": {
    "fairfuseApp": {
      "description": "Test description",
      "withSidebar": false,
      "parameters": {
        "CSV_URL": "fairfuse/assets/data/help-or-hinder-scholarships-30-5.csv"
      },
      "type": "react-component",
      "path": "fairfuse/assets/FairFuseApp.tsx",
      "nextButtonLocation": "sidebar",
      "showTitleBar": false,
      "response": []
    }
  },
  "components": {
    "introduction": {
      "type": "markdown",
      "path": "fairfuse/assets/introduction.md",
      "response": []
    },
    "taskRace": {
      "baseComponent": "fairfuseApp",
      "response": [
        {
          "id": "race",
          "type": "radio",
          "prompt": "What is the <strong>race</strong> of <strong>Taylor Landry</strong>?",
          "options": ["Native", "Black", "White", "Pacific Islander", "Asian"],
          "location": "sidebar"
        }
      ]
    },
    "taskGroupAdv": {
      "baseComponent": "fairfuseApp",
      "response": [
        {
          "id": "groupAdv",
          "type": "checkbox",
          "prompt": "Which race groups are <strong>over advantaged</strong> in the <strong>Math</strong> ranking? (Please select all that apply)",
          "options": ["Native", "Black", "White", "Pacific Islander", "Asian"],
          "location": "sidebar"
        }
      ]
    },
    "taskMostUnfairRanking": {
      "baseComponent": "fairfuseApp",
      "response": [
        {
          "id": "mostUnfair",
          "type": "radio",
          "prompt": "Which of the 3 rankings is the <strong>most unfair</strong>? Please verbalize your thoughts, process, and reason.",
          "options": ["Math", "Reading", "Writing"],
          "location": "sidebar"
        },
        {
          "id": "mostUnfairVerbalizedConfirm",
          "type": "checkbox",
          "prompt": "Confirmation",
          "options": ["I have verbalized my thoughts"],
          "minSelections": 1,
          "maxSelections": 1,
          "location": "sidebar"
        }
      ]
    },
    "taskMostAdvWhite": {
      "baseComponent": "fairfuseApp",
      "response": [
        {
          "id": "mostAdvWhite",
          "type": "radio",
          "prompt": "Which of the 3 rankings have the <strong>most advantaged White</strong> race group?",
          "options": ["Math", "Reading", "Writing"],
          "location": "sidebar"
        }
      ]
    },
    "taskRankComparison": {
      "baseComponent": "fairfuseApp",
      "response": [
        {
          "id": "rankComparison",
          "type": "radio",
          "prompt": "How is <strong>Taylor Landry's</strong> position ranked in <strong>Math</strong> compared to <strong>Reading</strong>?",
          "options": ["Higher", "Somewhat similar", "Lower"],
          "location": "sidebar"
        }
      ]
    },
    "taskCandidateDisagreement": {
      "baseComponent": "fairfuseApp",
      "response": [
        {
          "id": "candidateName",
          "type": "reactive",
          "prompt": "Select the candidate with <strong>most disagreement</strong> between <strong>Math</strong> and <strong>Reading</strong> rankings. (Click on the candidate's name on the right) Please verbalize your thoughts, process, and reason.",
          "location": "sidebar"
        },
        {
          "id": "candidateDisagreementVerbalizedConfirm",
          "type": "checkbox",
          "prompt": "Confirmation",
          "options": ["I have verbalized my thoughts"],
          "minSelections": 1,
          "maxSelections": 1,
          "location": "sidebar"
        }
      ]
    },
    "taskConsensusComparison": {
      "baseComponent": "fairfuseApp",
      "response": [
        {
          "id": "mostDissimilarBase",
          "type": "radio",
          "prompt": "<strong>Step 1:</strong> Generate a consensus ranking using the button on the left sidebar.<br/><strong>Step 2:</strong> Use the pin icon in the heading of the generated ranking to pin the ranking.<br/><strong>Step 3:</strong> Which base ranking is most dissimilar to the consensus ranking you just generated? Please verbalize your thoughts, process, and reason.",
          "options": ["Math", "Reading", "Writing"],
          "location": "sidebar"
        },
        {
          "id": "mostDissimilarVerbalizedConfirm",
          "type": "checkbox",
          "prompt": "Confirmation",
          "options": ["I have verbalized my thoughts"],
          "minSelections": 1,
          "maxSelections": 1,
          "location": "sidebar"
        }
      ]
    },
    "datasetChange": {
      "type": "markdown",
      "path": "fairfuse/assets/data-change.md",
      "showTitleBar": false,
      "withSidebar": false,
      "response": [],
      "style": {
        "maxWidth": "800px",
        "margin": "200px auto"
      }
    },
    "taskFreeGeneration": {
      "baseComponent": "fairfuseApp",
      "parameters": {
        "CSV_URL": "fairfuse/assets/data/help-or-hinder-scholarships-30-5-gen-v2.csv"
      },
      "response": [
        {
          "id": "finalConsensusRanking",
          "type": "shortText",
          "prompt": "Generate a fair consensus ranking that is \n - representative of all base rankings and\n - does not over or under advantage race groups. \nTips:\n Use the slider near the generation button to increase or decrease the level of fairness before you generate a ranking.\n To modify a generated ranking, you can drag and drop candidate cards.\n You can swap the position of a ranking by dragging the named header on the top of each ranking and placing it near the consensus ranking.\n You may pin generated rankings to compare multiple generated rankings.\n**Enter the name of your chosen consensus ranking (e.g. CON#1)**. Please verbalize your thoughts, process, and reasoning as you work throught this task.",
          "location": "sidebar"
        },
        {
          "id": "finalConsensusRankingVerbalizedConfirm",
          "type": "checkbox",
          "prompt": "Confirmation",
          "options": ["I have verbalized my thoughts"],
          "minSelections": 1,
          "maxSelections": 1,
          "location": "sidebar"
        }
      ]
    },
    "taskFreeGenerationFairWashing": {
      "baseComponent": "fairfuseApp",
      "parameters": {
        "CSV_URL": "fairfuse/assets/data/fairwashing.csv"
      },
      "response": [
        {
          "id": "finalConsensusRanking",
          "type": "shortText",
          "prompt": "Generate a fair consensus ranking that is \n - representative of all base rankings and\n - does not over or under advantage race groups.\n\n**Tips:**\n - After generating a consensus, use the slider near the generation button to increase or decrease the level of fairness before you generate a fair cosnensus ranking.\n - To modify a generated ranking, you can drag and drop candidate cards.\n - You can swap the position of a ranking by dragging the named header on the top of each ranking and placing it near the consensus ranking.\n - You may pin generated rankings to compare multiple generated rankings.\n\n**When you are done, enter the name of your chosen consensus ranking below (e.g. Consensus 1)**. Please verbalize your thoughts, process, and reasoning as you work throught this task.",
          "placeholder": "e.g. Consensus 1",
          "location": "sidebar"
        },
        {
          "id": "finalConsensusRankingVerbalizedConfirm",
          "type": "checkbox",
          "prompt": "Confirmation",
          "options": ["I have verbalized my thoughts"],
          "minSelections": 1,
          "maxSelections": 1,
          "location": "sidebar"
        }
      ]
    },
    "reflectCompare": {
      "baseComponent": "fairfuseApp",
      "parameters": {
        "CSV_URL": "fairfuse/assets/data/fairwashing.csv",
        "REPLAY_FROM": "taskFreeGenerationFairWashing"
      },
      "instruction": "Please review the consensus ranking you generated/selected and explain how it compare with the three base rankings? Please verbalize your thoughts as you look it over.",
      "response": [
        {
          "id": "reflectCompareVerbalizedConfirm",
          "type": "checkbox",
          "prompt": "Confirmation",
          "options": ["I have verbalized my thoughts"],
          "minSelections": 1,
          "maxSelections": 1,
          "location": "sidebar"
        }
      ]
    },
    "reflectDisplacement": {
      "baseComponent": "fairfuseApp",
      "parameters": {
        "CSV_URL": "fairfuse/assets/data/fairwashing.csv",
        "REPLAY_FROM": "reflectCompare"
      },
      "instruction": "Please review the consensus ranking you just generated/selected. \n - Which candidates, if any, moved substantially compared with the base rankings?\n - How well do you think fairness has been achieved in this ranking? \n - Would you make make any changes about the ranking now? \n\nPlease verbalize your thoughts.",
      "response": [
        {
          "id": "reflectDisplacementVerbalizedConfirm",
          "type": "checkbox",
          "prompt": "Confirmation",
          "options": ["I have verbalized my thoughts"],
          "minSelections": 1,
          "maxSelections": 1,
          "location": "sidebar"
        }
      ]
    },
    "reflectJustify": {
      "baseComponent": "fairfuseApp",
      "parameters": {
        "CSV_URL": "fairfuse/assets/data/fairwashing.csv",
        "REPLAY_FROM": "reflectDisplacement"
      },
      "response": [
        {
          "id": "reflectJustify",
          "type": "longText",
          "prompt": "Why did you accept this ranking?",
          "location": "sidebar"
        },
        {
          "id": "reflectWouldRerank",
          "type": "radio",
          "prompt": "Having reviewed it, would you change anything about this ranking now?",
          "options": ["Yes", "No"],
          "location": "sidebar"
        },
        {
          "id": "reflectRerankDescribe",
          "type": "longText",
          "prompt": "If so, make the change in the ranking view and describe what you changed and why. If not, explain why not.",
          "location": "sidebar"
        },
        {
          "id": "reflectJustifyVerbalizedConfirm",
          "type": "checkbox",
          "prompt": "Confirmation",
          "options": ["I have verbalized my thoughts"],
          "minSelections": 1,
          "maxSelections": 1,
          "location": "sidebar"
        }
      ]
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "introduction",
      "$screen-recording.components.screenRecordingPermission",
      "taskRace",
      "taskGroupAdv",
      "taskMostUnfairRanking",
      "taskMostAdvWhite",
      "taskRankComparison",
      "taskCandidateDisagreement",
      "taskConsensusComparison",
      "datasetChange",
      "taskFreeGenerationFairWashing",
      "reflectDisplacement"
    ]
  }
}
